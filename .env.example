# Copy this file to .env and fill in real values for your environment.
# Never commit the real .env file.

# Django secret key — generate a real one for any non-local environment, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key

# Set to False in production.
DJANGO_DEBUG=True

# Comma-separated list of allowed hostnames.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of origins trusted for CSRF (needed behind HTTPS proxies/CDNs).
# Example: DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL connection string. If unset, the project falls back to local SQLite.
# Example: DATABASE_URL=postgres://user:password@localhost:5432/ecotransit
DATABASE_URL=

# OpenRouteService API key for routing/geocoding (core/services/openroute.py).
# Get one at https://openrouteservice.org/dev/#/signup
OPENROUTESERVICE_API_KEY=
OPENROUTESERVICE_BASE_URL=https://api.openrouteservice.org

# --- Security toggles (optional overrides) ---
# By default these are derived from DJANGO_DEBUG (on when DEBUG=False).
# Uncomment to force a specific value.
# DJANGO_SECURE_SSL_REDIRECT=False
# DJANGO_SESSION_COOKIE_SECURE=False
# DJANGO_CSRF_COOKIE_SECURE=False
# DJANGO_SECURE_HSTS_SECONDS=0
