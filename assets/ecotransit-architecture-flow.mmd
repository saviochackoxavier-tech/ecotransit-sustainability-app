flowchart LR
    U["User browser\nDjango templates + Tailwind"] --> V["Dashboard / Tracking / History / Profile"]
    V --> L["Leaflet.js\nGPS point capture"]
    L --> API["Django JSON API\n/api/journeys · /api/routes · /api/geocode"]
    API --> J["Journey domain\nJourney + JourneyPoint"]
    API --> ORS["OpenRouteService\nRouting + geocoding"]
    J --> CARB["Carbon service\nDistance + emissions snapshot"]
    J --> INT["Integrity service\nSHA-256 journey hash"]
    J --> GAME["Gamification service\nPoints · streaks · badges"]
    CARB --> DB[("SQLite / PostgreSQL")]
    INT --> DB
    GAME --> DB
    J --> DB
